# Example environment variables (no secrets)
VITE_APP_NAME=Tarot
VITE_API_BASE=/api

# --- AI integration (examples only, do not put real secrets here) ---
# Gemini API key (set real key in .env.local only; NEVER commit real keys)
VITE_GEMINI_API_KEY=
# Master switch to enable/disable AI reading (default off for safety)
VITE_ENABLE_AI_READING=false
# Default model for development/testing (free tier recommended)
VITE_GEMINI_MODEL=gemini-1.5-flash
# Generation config knobs (safe defaults)
# Max tokens the model can output for a single response
VITE_AI_MAX_TOKENS=896
# HTTP timeout for AI requests in milliseconds
VITE_AI_TIMEOUT_MS=15000
# Retry count for transient failures (additional attempts besides the first)
VITE_AI_RETRIES=2

# --- Hedged requests scaffold (Plan C: controlled concurrent race, default OFF) ---
# 是否启用受控并发竞速（默认关闭）；可用值：0/1/true/false
VITE_AI_HEDGE_ENABLED=0
# 第二路（如 Zhipu）起跑延迟（毫秒），默认 250
VITE_AI_HEDGE_DELAY_MS=250
# 是否在胜出方返回后中止败方请求（默认启用）；可用值：0/1/true/false
VITE_AI_ABORT_LOSER=1
# 竞速日志级别：debug|info|warn|error（默认 warn）
VITE_AI_HEDGE_LOG_LEVEL=warn
