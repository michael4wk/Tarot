{
  "name": "tarot2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "bash ./dev.ai.sh",
    "build": "git lfs install || true && git config -f .lfsconfig lfs.url https://github.com/michael4wk/Tarot.git/info/lfs && git lfs fetch --include='assets/images/**' && git lfs checkout --include='assets/images/**' && vite build",
    "preview": "vite preview --strictPort",
    "lint": "eslint . --ext .ts,.tsx,.vue,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue,.js,.jsx --fix && prettier . --write",
    "format": "prettier . --write",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/**/*.spec.ts",
    "test:watch": "vitest src/**/*.spec.ts",
    "clean": "rimraf dist coverage .vite",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "undici": "7.16.0",
    "vue": "^3.4.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.20.0",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "5.5.4",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}